# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database ---
# MongoDB connection string (Atlas or self-hosted).
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/nickarts?retryWrites=true&w=majority"

# --- Auth ---
# Signing key for the admin session JWT. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
# Where contact-form submissions are delivered.
CONTACT_EMAIL="nickartsstudio@gmail.com"
# Verified sender. Must be on a domain you have verified in Resend — the
# resend.dev sandbox sender only delivers to your own account address.
CONTACT_FROM_EMAIL="NickArts Studio <studio@yourdomain.com>"

# --- Uploads (UploadThing) ---
# https://uploadthing.com/dashboard -> API Keys
UPLOADTHING_TOKEN=""

# --- Optional: local development escape hatches ---
# Forces DNS to Google's resolvers and pins lookups to IPv4. Only enable if you
# hit "querySrv ECONNREFUSED" connecting to Atlas locally. Never set in production:
# it overrides the platform resolver and breaks private/VPC hostnames.
# ENABLE_DNS_PATCH="1"

# --- Seeding (not read at runtime) ---
# Optional non-interactive password for scripts/seed-admin.ts.
# SEED_ADMIN_PASSWORD=""
